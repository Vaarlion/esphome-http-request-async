# Device test secrets — copy this file to secrets.yaml and fill in your values.
#
# secrets.yaml is gitignored. Never commit it.
#
# Used by: tests/esphome/device_test.yaml

# WiFi credentials
wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"

# ESPHome API encryption key (base64, 32 bytes)
# Generate one: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_key: "REPLACE_WITH_YOUR_BASE64_API_KEY="

# OTA update password
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# IP:port of the test server (tools/test_server.py)
# Run on your dev machine: python3 tools/test_server.py
# Then set this to your machine's LAN IP and the port (default 8765)
test_server: "192.168.x.x:8765"
